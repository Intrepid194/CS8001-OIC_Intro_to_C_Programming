(check llort 19 "def-A")
(def snort (+ 5 6 (* 7 8)))
(check snort 67 "def-B")
(if #t (def blort 18))
(check blort 18 "def-C")
(def snap (def crackle (def pop 112)))
(check (list snap crackle pop) '(112 112 112) "def-D")
(if #f (def pop 113))
(check pop 112 "def-E")

(check ((fn (x) x) 5) 5 "fn-A")
(check ((fn (x) (+ x 1)) 5) 6 "fn-B")
(check ((fn () 17)) 17 "fn-C")
(check ((fn (x y z) (+ x (* y z))) 3 4 5) 23 "fn-D")
(check ((fn (x & xs) (list xs x)) 1) '(() 1) "fn-E")
(check ((fn (x & xs) (list xs x)) 1 2 3 4) '((2 3 4) 1) "fn-F")
(check ((fn (f) (f 13)) (fn (x) (* x x))) 169 "fn-G")
(check ((fn recur (x) (if (<= x 0) 0 (+ x (recur (- x 1))))) 5) 15 "fn-H")
(check ((fn (f) (f 5)) (fn (x) (+ x 1))) 6 "fn-I")
(check (((fn (f g) (fn (x) (f (g x)))) (fn (x) (+ x 1)) (fn (x) (* x 2))) 100) 201 "fn-J")
(check ((fn () ())) () "fn-K")
(check ((((fn () (fn () (fn () ())))))) () "fn-L")

