(check (list apple banana grape) '(1 2 3) "do-B")
(check (do (+ 1 2)) 3 "do-C")
(check (do) #t "do-D")

(def cell-1 (cell 0))
(def cell-2 (cell 0))
(def cell-alias cell-1)
(check (= cell-1 cell-2) #f "cell-A")
(check (:= cell-1 7) 7 "cell-B")
(check (! cell-alias) 7 "cell-C")

(def cell-4 (cell 0))
(def cell-5 (cell cell-4))
(:= cell-4 cell-5)
(check (= (! (! (! (! (! (! cell-4)))))) cell-4) #t "cell-D")
(check (= (! (! (! (! (! (! (! cell-4))))))) cell-4) #f "cell-E")
(:= cell-5 0)
(def cell-4 0)
(def cell-5 0)

