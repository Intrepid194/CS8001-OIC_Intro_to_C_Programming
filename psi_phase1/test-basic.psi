(check (loop #f) #t "loop-A")

(def ctr (cell 0))
(check (do (:= ctr 0)
           (loop (if (< (! ctr) 10)
                     (:= ctr (+ 1 (! ctr)))))
	   (! ctr)) 10 "loop-B")

(check (head (try
         (do (:= ctr 6)
	     (loop (if (< (/ 100 (! ctr)) 1000)
	               (:= ctr (- (! ctr) 1))))
             (! ctr))
	     )) #f "loop-C")

(def acc (cell 0))
(check (do (:= ctr 0)
           (loop (if (<= (! ctr) 37)
	             (do (:= acc (+ (! acc) (* (! ctr) (! ctr))))
		         (:= ctr (+ (! ctr) 1)))))
	   (! acc))
	17575 "loop-D")

(check (if #f (loop #t)) #f "loop-E")

(def incr-closure ()
  ((fn (cell)
     (fn () (do (:= cell (+ 1 (! cell)))
                 (! cell))))
   (cell 0)))

(def ic-1 (incr-closure))
(check (ic-1) 1 "closure-A")
(check (ic-1) 2 "closure-B")
(check (ic-1) 3 "closure-C")
(def ic-2 (incr-closure))
(check (ic-2) 1 "closure-D")
(def ic-3 ic-1)
(check (ic-3) 4 "closure-E")
(check (ic-1) 5 "closure-F")

