(check (chr ()) "" "chr-A")
(check (chr '(68 79 71)) "DOG" "chr-B")
(check (chr '(97 32 98 32 99)) "a b c" "chr-C")
(check (chr '(100 34 101)) "d\"e" "chr-D")
