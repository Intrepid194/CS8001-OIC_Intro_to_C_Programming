(check (try (+ 3 5)) '(#t 8) "try-A")
(check (try (/ 1 0)) '(#f division-by-zero) "try-B")

(check (try (error "puke")) '(#f "puke") "error-A")

(check (read "1") 1 "read-A")
(check (read "b") 'b "read-B")
(check (read "(1 2 3)") '(1 2 3) "read-C")
(check (read "(+ 5 7)") '(+ 5 7) "read-D")
(check (read "(\"cat\" 137 (a b))") '("cat" 137 (a b)) "read-E")
(check (head (try (read "(1 2 3"))) #f "read-F")
(check (head (try (read ""))) #f "read-G")
(check (head (try (read ")(+ 1 2)"))) #f "read-H")
(check (head (try (read "(+ 1 2) (+ 3 4)"))) #f "read-I")
(check (head (try (read "g#137"))) #f "read-J")
(check (head (try (read "a b"))) #f "read-K")
(check (read "(+ 1 2\n 3)") '(+ 1 2 3) "read-L")
(check (head (try (read "a\nb"))) #f "read-M")
(check (read "\"a\nb\"") "a\nb""read-N")

(check (eval 1) 1 "eval-A")
