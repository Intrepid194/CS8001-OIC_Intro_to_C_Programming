"None of the following should quit."

(check '(quit) '(quit) "quit-A")
(check (type quit) 'function "quit-B")
(check 'quit 'quit "quit-C")
(check (eval ''(quit)) '(quit) "quit-D")
(check (read "(quit)") '(quit) "quit-E")
(should-fail (try (do (/ 1 0) (quit))) "quit-F")
(check (do (def garbage () (quit)) (type garbage)) 'function "quit-G")
(check (if #f (quit)) #f "quit-H")
(should-fail (try ((fn (x) (quit)) (/ 1 0))) "quit-I")

"An integration test -- Some basic lambda calculus"

(def church (n)
  (fn (f)
    (fn (x)
      (if (= n 0) x (f (((church (- n 1)) f) x))))))

(def unchurch (f)
  ((f (fn (x) (+ 1 x))) 0))

(def cn-plus (n m)
  (fn (f)
    (fn (x)
      ((n f) ((m f) x)))))

(def cn-times (n m)
  (fn (f)
    (fn (x)
      ((n (m f)) x))))

(def cn-exp (n m)
  (m n))

(check (unchurch (cn-plus (church 3) (church 4))) 7 "lc-A")
(check (unchurch (cn-times (cn-plus (church 2) (church 3))
                           (church 7))) 35 "lc-B")
(check (unchurch
  (cn-plus
    (cn-times (cn-exp (church 2) (cn-plus (church 2) (church 4)))
              (church 2))
    (cn-exp (church 4) (church 2)))) 144 "lc-C")

(should-fail (try (fn (x x) x))          "fn-dupe-argname")
(should-fail (try (fn (x y &) x))        "fn-no-restname")
(should-fail (try (fn (x & y z) x))      "fn-two-restname")

(should-fail (try (def tb1 (x x) x))     "def-dupe-argname")
(should-fail (try (def tb2 (x y &) x))   "def-no-restname")
(should-fail (try (def tb3 (x & y z) x)) "def-two-restname")

(should-fail (try tb1) "tb1-unbound")
(should-fail (try tb2) "tb2-unbound")
(should-fail (try tb3) "tb3-unbound")

(should-fail (try (fn 5 (x) x)) "fn-name-number")
(should-fail (try (fn "5" (x) x)) "fn-name-string")
(should-fail (try (fn (5) (x) x)) "fn-name-list")
/
(check (+ 51020145927 33019320686) 84039466613 "add-64")
(check (* 123707 303275119) 37517255146133 "mul-64")
(check (% (* 18810203 9987696) 20151127) 1 "mod-64")

(def count-cell (cell 0))
(def count () (:= count-cell (+ (! count-cell) 1)))

(check (or #t (/ 1 0)) #t "or-A")
(check (or 3 #t) 3 "or-B")
(check (or) #f "or-C")
(check (or #f 17) 17 "or-D")
(check (or #f #f #f #f #f #f #f #f) #f "or-E")
(check (or #f #f #f #f #f #f #f #t) #t "or-F")
(check (or #t) #t "or-G")
(check (or #f) #f "or-H")
(check (do (or (count) (count)) (! count-cell)) 1 "or-I")

(check (and #f (/ 1 0)) #f "and-A")
(check (and 3 #t) #t "and-B")
(check (and) #t "and-C")
(check (and #t 17) 17 "and-D")
(check (and #t #t #t #t #t #t #t #t) #t "and-E")
(check (and #t #t #t #t #t #t #t #f) #f "and-F")
(check (and #t #f #t #t #t #t #t #t) #f "and-G")
(check (and #t) #t "and-H")
(check (and #f) #f "and-I")
(check (do (:= count-cell 0) (and (count) (count)) (! count-cell)) 2 "and-J")

(check (let 5) 5 "let-A")
(should-fail (try (let 5 6)) "let-B")
(should-fail (try (let)) "let-C")
(check (let a 4 (* a a)) 16 "let-D")
(check (let a 4 b (* a 3) (list a b)) '(4 12) "let-E")
(check (let a 1 a (+ a a) a (+ a a) a (+ a a) a) 8 "let-F")
(check (let f (fn f (x) (if (= x 0) 0 (+ x (f (- x 1))))) (f 10)) 55 "let-G")

