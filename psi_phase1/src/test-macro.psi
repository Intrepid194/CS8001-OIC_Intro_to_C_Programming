(load "test-common.psi")
(load "__start.psi")

(macro should-fail (x str)
  (list 'check (list 'head (list 'try x)) #f str))

(macro while (c body)
  (list 'loop (list 'if c (list 'do body #t))))

(def while-1 (cell 1))
(def while-2 (cell 0))

(while (< (! while-1) 100)
  (do (:= while-2 (+ (! while-2) (! while-1)))
      (:= while-1 (* 3 (! while-1)))))

(check (! while-1) 243 "while-A")
(check (! while-2) 121 "while-B")

(macro for (x xs body)
  (if (= type xs) 'list
    (let cell-name (new-symbol)
         cell-value (new-symbol)
      (list 'let cell-name (list 'cell xs)
        (list 'loop
          (list 'let cell-value (list '! cell-name)
	    (list 'if (list '!= cell-value ())
	      (list 'do
	        (list 'let x (list 'head cell-value) body)
		(list ':= cell-name (list 'tail cell-value))))))))))

(def for-1 (cell 0))
(def c -47)  "Check that local variable isn't bound."

(for c (ord "cat")
  (:= for-1 (+ (! for-1) c)))

(check (! for-1) 312 "for-A")
(check c -47 "for-B")

(macro for-under (x n body)
  (list 'for x (list 'range 0 n) body))

(def for-2 (cell 0))
(def i -48)

(for-under i 100 (:= for-2 (+ (* i i) (! for-2))))

(check (! for-2) 328350 "for-upto-A")
(check i -48 "for-upto-B")

(macro cond (& forms)
  (if (!= (% (length forms) 2) 0)
    (error "cond : requires an even number of forms")
    (if (= forms ()) #f
      (list 'if (head forms) (head (tail forms))
        (cons 'cond (tail (tail forms)))))))

(check (cond) #f "cond-A")
(check (cond #t      1 #f (/ 1 0)) 1 "cond-B")
(check (cond (= 3 3) 1 #f (/ 1 0)) 1 "cond-C")
(check (cond #f      1 #t (/ 17 3)) 5 "cond-D")
(check (cond (= 4 3) 1 #t (/ 17 3)) 5 "cond-E")
(check (cond #f 0 #f 1 #f 2 #f 3 #t 4 #f 5) 4 "cond-F")
(should-fail (cond #t 1 #f 2 3) "cond-G")

(macro case (x & forms)
  (let var-name (new-symbol)
    (list 'let var-name x
      (cons 'cond
        (concat
          (map
	    (fn (c)
              (if (= (length c) 2)
	        (list
	          (list '= var-name (head c))
		  (head (tail c)))
	        (list
	          #t
	          (head c))))
            (chunk 2 forms)))))))

(def case-once (cell 0))
(def case-f (x) (do (:= case-once (+ (! case-once) 1)) x))

(check (case (case-f (+ 3 2)) 4 "four" 5 "five" 6 "six") "five" "case-A")
(check (case (case-f (* 3 2)) 4 "four" 5 "five") #f "case-B")
(check (case (case-f (* 3 3)) 4 "four" 5 "five" 6) 6 "case-C")
(check (case (case-f (* 3 3))) #f "case-D")
(should-fail (case) "case-E")
(check (! case-once) 4 "case-F")

(if (not (is-bound 'io-off))
  (status))
